{
  "name": "teachinghub2",
  "version": "0.1.0",
  "private": true,
  "description": "Prototyp-Neubau von teachinghub.unibe.ch (Next.js + Payload CMS)",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project unit",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project int",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "legacy:crawl": "tsx scripts/migration/crawl.ts",
    "legacy:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migration/import.ts",
    "legacy:changes": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migration/changes.ts",
    "legacy:delta": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migration/delta.ts",
    "legacy:rehash": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migration/rehash.ts",
    "search:reindex": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migration/reindex.ts",
    "ai:reindex": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/ai/reindex.ts",
    "ai:rotate-keys": "tsx scripts/ai/rotate-keys.ts",
    "legacy:parity": "tsx scripts/migration/parity.ts",
    "e2e:fixtures": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migration/import-fixtures.ts",
    "topics:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/topics/import.ts",
    "auth:migrate": "tsx scripts/auth/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@better-auth/passkey": "1.7.27",
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/email-nodemailer": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/translations": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "better-auth": "1.7.27",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "html-to-image": "1.11.13",
    "jsdom": "28.0.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "payload": "3.94.1",
    "pg": "8.20.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "28.0.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  }
}

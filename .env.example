# Kopieren nach .env und Werte anpassen. .env wird nie committet (Entscheidung 5.2).

# PostgreSQL (im Docker-Stack: Host "db")
DATABASE_URL=postgres://teachinghub:teachinghub@db:5432/teachinghub2

# Geheimer Schlüssel für Payload, z. B. erzeugen mit: openssl rand -hex 32
PAYLOAD_SECRET=bitte-ersetzen

# Öffentliche Basis-URL der App
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Mail (lokal: Mailpit fängt alle Mails ab, Web-Oberfläche http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=teachinghub2@localhost

# Wöchentlicher Delta-Abgleich mit der Altsite (montags 06:00), nur bei laufendem Server
LEGACY_DELTA_WEEKLY=false

# Maschinelle Übersetzung beim Seitenaufruf (Entscheidung 4.3). Leer = deutsche Fassung mit Hinweis.
GOOGLE_TRANSLATE_API_KEY=

# Mitgliederkonten (Better Auth, Entscheidung 6.1): Magic Link + Passkey
BETTER_AUTH_SECRET=bitte-ersetzen
BETTER_AUTH_URL=http://localhost:3000
# Zusätzliche erlaubte Ursprünge, z. B. der E2E-Container
BETTER_AUTH_TRUSTED_ORIGINS=http://app:3000

# edu-ID (OIDC, Phase 7) – leer = abgeschaltet
EDUID_DISCOVERY_URL=
EDUID_CLIENT_ID=
EDUID_CLIENT_SECRET=

# Ask-a-question (Phase 6, Entscheidungen 8.4–8.6)
# Geheimer Schlüssel für die Verschlüsselung der API-Schlüssel der Mitglieder (mind. 32 Zeichen),
# z. B. erzeugen mit: openssl rand -hex 32 – NICHT ändern, sonst sind gespeicherte Schlüssel unbrauchbar.
AI_KEY_SECRET=bitte-ersetzen-mindestens-32-zeichen-lang
# Lokales Embedding-Modell (Docker-Dienst „ollama“); AI_EMBEDDER=fake nur für Tests
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
# Optional: Schwellwert der Ähnlichkeit, ab dem eine Quelle passt (Standard 0.45)
AI_MIN_SCORE=
